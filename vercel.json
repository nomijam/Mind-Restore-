{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/condition/female-psychologist-online",
      "destination": "/condition/female-psychologist",
      "statusCode": 301
    },
    {
      "source": "/pricing",
      "destination": "/plans-and-pricing",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/((?!\\.well-known/|llms\\.txt$|assets/|images/|sitemap\\.xml$|robots\\.txt$|favicon\\.svg$|manifest\\.json$|site\\.webmanifest$|services$|plans-and-pricing$|about$|how-it-works$|timeline$|blog$|resources$|tools$|faq$|emergency$|contact$|blog/(?:understanding-anxiety-roots|depression-and-hope|healthy-boundaries-relationships|workplace-burnout-recovery|panic-attacks-emergency-toolkit|overcoming-social-anxiety-pakistan|managing-intrusive-thoughts-ocd|grief-loss-emotional-healing)$|condition/(?:anxiety-counselling|depression-counselling|stress-burnout|sleep-disorders|health-anxiety|anger-management|phobia-treatment|ocd-treatment|ptsd-trauma-therapy|relationship-breakup|grief-loss|addiction-counselling|anonymous-counselling|female-psychologist|marriage-couple-counselling|family-counselling-therapy|child-teen-psychologist|student-counselling)$|city/(?:lahore|karachi|islamabad-rawalpindi|faisalabad|peshawar|multan|overseas-worldwide)$|.*\\.html$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=43200"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/.well-known/(ard|ai-catalog)\\.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
